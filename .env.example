# ─── Brandmark environment ───────────────────────────────────────────────
# Copy this file to .env and fill in real values. Never commit .env.

# Database
# Local dev: SQLite file (relative to prisma/). Production: PostgreSQL URL.
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/brandmark?sslmode=require"

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-me-with-a-64-char-random-hex-string"

# AI (optional). Without a key the app uses its built-in local NLP/ranking engine.
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"
# OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
# AI_PROVIDER="openai"

# Email delivery (optional). Without it, verification/reset links are logged to
# the server console (development) instead of being emailed.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Brandmark <no-reply@example.com>"

# Rate limiting note: the in-memory limiter is per-instance. For multi-instance
# production deployments set REDIS_URL and swap src/lib/rate-limit.ts.
# REDIS_URL="redis://..."

# Seed demo accounts (development only; seed refuses to run in production)
SEED_ADMIN_EMAIL="admin@brandmark.local"
SEED_ADMIN_PASSWORD="AdminPass123!"
SEED_CUSTOMER_EMAIL="demo@brandmark.local"
SEED_CUSTOMER_PASSWORD="DemoPass123!"
SEED_SELLER_EMAIL="seller@brandmark.local"
SEED_SELLER_PASSWORD="SellerPass123!"
