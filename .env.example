# ─── Brandmark environment ───────────────────────────────────────────────
# Copy this file to .env and fill in real values. Never commit .env.
# For production on Vercel, set these in the Vercel project settings.

# ─────────────────────────────────────────────────────────────────────────
# Database (REQUIRED)
# Local dev: SQLite file (relative to prisma/).
# Production on Vercel: PostgreSQL via Vercel Postgres or external provider.
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/brandmark?sslmode=require"
# Do NOT use file:./dev.db in production — serverless filesystems are read-only.
# Vercel builds with prisma/schema.production.prisma (provider = postgresql).
DATABASE_URL="file:./dev.db"

# Production only: DIRECT (non-pooled) PostgreSQL URL used by migrations.
# DATABASE_URL must use the pooler (PgBouncer / Supavisor / Prisma Accelerate)
# with ?pgbouncer=true for high concurrency; DIRECT_URL bypasses the pooler.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/brandmark?sslmode=require"

# ─────────────────────────────────────────────────────────────────────────
# App (REQUIRED in production)
APP_URL="http://localhost:3000"
# PUBLIC URL of your deployed site, e.g. https://brandmark.vercel.app
# NODE_ENV="development" | "production" | "test"
NODE_ENV="development"

# ─────────────────────────────────────────────────────────────────────────
# Auth (REQUIRED in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Also signs derived reset/verification tokens and hashes IP rate-limit keys.
SESSION_SECRET="replace-me-with-a-64-char-random-hex-string"

# ─────────────────────────────────────────────────────────────────────────
# AI (optional — local engine used when not configured)
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"
# OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
# AI_PROVIDER="openai"

# ─────────────────────────────────────────────────────────────────────────
# Email delivery (optional — links logged to console without it)
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Brandmark <no-reply@example.com>"

# ─────────────────────────────────────────────────────────────────────────
# Redis / KV (REQUIRED in production, optional locally)
# Distributed rate limits, session cache/revocation and catalog snapshots.
# Accepts Upstash REST credentials or the Vercel KV aliases.
# Without these, a process-local fallback is used (dev/test only; /health
# reports "degraded" in production).
# UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="AXxxx..."
# Vercel KV aliases (either pair works):
# KV_REST_API_URL="https://xxxx.kv.vercel-storage.com"
# KV_REST_API_TOKEN="AXxxx..."

# ─────────────────────────────────────────────────────────────────────────
# Seed demo accounts (development only; seed refuses to run in production)
SEED_ADMIN_EMAIL="admin@brandmark.local"
SEED_ADMIN_PASSWORD="AdminPass123!"
SEED_CUSTOMER_EMAIL="demo@brandmark.local"
SEED_CUSTOMER_PASSWORD="DemoPass123!"
SEED_SELLER_EMAIL="seller@brandmark.local"
SEED_SELLER_PASSWORD="SellerPass123!"